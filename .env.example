# ─────────────────────────────────────────────────────────────────────────────
# MCP Gate — Environment Variables
# Copy this file to .env and fill in values before running `make dev`.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=mcpgate
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mcpgate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Constructed DSN used by Go services.
POSTGRES_DSN=postgres://mcpgate:changeme@postgres:5432/mcpgate?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=mcpgate
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=mcpgate
RABBITMQ_URL=amqp://mcpgate:changeme@rabbitmq:5672/mcpgate

# ── Service ports ─────────────────────────────────────────────────────────────
PROXY_PORT=8080
ADMINAPI_PORT=8081

# ── Admin auth (Phase 1: hardcoded token; replaced with JWT in Phase 8) ───────
# Use a long random string here, e.g.: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token-replace-in-production

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: debug | info | warn | error
LOG_LEVEL=info

# ── Downstream MCP server (wired in Phase 9) ─────────────────────────────────
# DOWNSTREAM_TARGET_URL=http://localhost:9000
# BAMBOOHR_API_KEY=       <-- example; set via auth_secret_ref "env:BAMBOOHR_API_KEY"
